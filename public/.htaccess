# ==============================================================================
# 1. KONFIGURASI UTAMA & ENGINE
# ==============================================================================
RewriteEngine On

# PENTING: Matikan MultiViews. Ini penyebab utama konflik folder vs file di cPanel
Options -Indexes -MultiViews
DirectoryIndex index.html

# ==============================================================================
# 2. BYPASS UNTUK STATIC ASSETS
# ==============================================================================
# Jangan proses file yang sudah ada (gambar, css, js, dll)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Bypass _next folder (aset build Next.js)
RewriteRule ^_next/ - [L]

# ==============================================================================
# 3. KEAMANAN FILE & SERVER
# ==============================================================================
<FilesMatch "(\.env|\.htaccess|\.htpasswd|\.ini|\.log|\.bak|\.sql|\.git|\.zip)$">
    Require all denied
</FilesMatch>

# Abaikan request .txt (Next.js RSC - tidak diperlukan untuk static export)
RewriteCond %{QUERY_STRING} _rsc [NC]
RewriteRule \.txt$ - [R=204,L]

RewriteRule \.txt$ - [R=204,L]

<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>

# ==============================================================================
# 4. PENGALIHAN SEO (HTTPS & WWW)
# ==============================================================================
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)/$ /$1 [L,R=301]

# ==============================================================================
# 5. LOGIKA CLEAN URL (SOLUSI INTI)
# ==============================================================================

# KASUS A: DYNAMIC ROUTES (career/25, member/1, news/slug)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.html -f
RewriteRule ^(.+)$ /$1.html [L]

# KASUS B: KONFLIK FOLDER VS FILE (career.html vs career/)
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.html -f
RewriteRule ^(.+?)/?$ /$1.html [L]

# KASUS C: HALAMAN BIASA TANPA KONFLIK FOLDER
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# ==============================================================================
# 6. HALAMAN ERROR & PERFORMA
# ==============================================================================
ErrorDocument 404 /404.html

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>
